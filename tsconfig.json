{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/themes/classic/*": ["./src/themes/classic/changes/*", "./src/themes/classic/core/*"],
      "@/themes/bohemian/*": ["./src/themes/bohemian/changes/*", "./src/themes/bohemian/core/*"],
      "@/themes/luxury/*": ["./src/themes/luxury/changes/*", "./src/themes/luxury/core/*"],
      "@/*": [
        "./src/*",
        "./src/themes/classic/changes/*",
        "./src/themes/bohemian/changes/*",
        "./src/themes/luxury/changes/*"
      ]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
